# Environment Configuration
ENVIRONMENT=development
PORT=8000

# Database: Uses local SQLite by default for zero-friction setup.
# To connect to live Supabase, replace with your connection string:
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./ai_study.db

# Supabase Credentials (Optional for local mode, required for Supabase cloud sync)
SUPABASE_URL=
SUPABASE_KEY=

# AI / LLM Configuration
GEMINI_API_KEY=

# Security
SECRET_KEY=dev-secret-ai-study-student-key-2026
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
